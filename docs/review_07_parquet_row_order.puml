@startuml review_07_parquet_row_order
' Review unit 07 of 15 -- see docs/review_diagrams.md for the series.
' State AFTER commit 3e31654 (src +83/-67).
' Every number below is from a run of the two cases at commit 3e31654.
' Render: plantuml docs/review_07_parquet_row_order.puml

title Unit 07 -- identical parquet row order in both paths (a2bc4fb..3e31654)

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #FCFCFC
  BorderColor #777777
  DiamondBackgroundColor #F2F2F2
  DiamondBorderColor #777777
}
skinparam partition {
  BorderColor #8899AA
  FontColor #33495E
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

start

partition "the call -- unchanged parameters, two cases" {
  :GenerateData(
     num_obs=100, num_dims=3, ratio_dims=[1, 2, 2],
     density=[0.4, 0.1], seed=77,
     num_vars=2, var_dims=[3, 2],
     overlap=0.5, fixed_overlap=False,
     <b>case A</b>: max_obs=None      <b>case B</b>: max_obs=40)
  .generate(netcdf_filepath, parquet_filepath, parquet_tmp, merge_nc);
}

partition "validate, configure, place, measure -- unchanged" {
  :shape [4, 8, 8], num_obs 102, dim_split 2, var1 pinned on x1 at
  index 2, F1 0.8125. The arrays written to netCDF do not change
  in this unit; only the order of the parquet rows does;
}

partition "building the tabular store" {
  #FFCDD2:extract_non_nan_points used np.where on the record as laid
  out, so rows came out in C order of the FULL array (x0 slowest),
  and build_multi_var_dataframe emitted rows in the order coordinates
  were first discovered while walking the variables;
  note right #FFCDD2
    A chunk holds a slice of the split axis, so its rows
    were a different subset in a different order from the
    corresponding serial rows. Concatenating the chunks
    could not reproduce the serial file without a global
    sort, which a larger-than-memory dataset cannot afford.
  end note
  #C8E6C9:<b>ParquetBuilder._row_axes(num_dims, order_dim)</b>
  puts order_dim outermost: axes = [dim_split] + the rest
  the record is viewed through np.moveaxis before np.where,
  so rows are emitted with the SPLIT dimension slowest;
  #C8E6C9:build_single_var_dataframe and build_multi_var_dataframe
  both take order_dim, and generate() passes self.dim_split.
  Column order stays x0, x1, x2 then the variables;
  note right #C8E6C9
    With the split axis slowest, a chunk's rows are exactly
    the contiguous block serial would emit for those strata.
    Concatenating the chunks in chunk order reproduces the
    serial row order with no sort anywhere.
  end note
}

if (NTASKS) then (== 1  -- CASE A, serial)
  #FFF9C4:118 rows, same set, NEW order. First row goes from
  (x0 0.243888, x1 0.055323, x2 0.233005, var0 0.237503) to
  (x0 0.243888, x1 0.231410, x2 0.150654, var0 0.509314)
  parquet_0.parquet 6260 -> <b>6263 B</b>, ds.nc unchanged at 15729 B;
else (== 3  -- CASE B, parallel)
  #FFF9C4:each chunk writes its rows in the same convention, so the
  consolidated file is the serial file row for row
  parquet_0.parquet 5927 -> <b>5899 B</b>;
endif

partition "the single-variable flow (num_vars=1, density=0.4)" {
  #FFE0B2:touched: build_single_var_dataframe takes the same order_dim,
  so single-variable rows are reordered too.
  serial parquet 5401 -> 5396 B, parallel 5140 -> 5117 B;
}

stop

legend right
  |<#C8E6C9> green |= added or changed by THIS unit |
  |<#FFCDD2> red |= removed by THIS unit |
  |<#FFE0B2> orange |= single-variable flow touched by THIS unit |
  |<#FFF9C4> yellow |= generated data or file that changed as a result |
  | plain | unchanged since unit 06 |

  <b>What to review in unit 07</b>
  * _row_axes and the np.moveaxis view -- is the column
    reassembly (names[dim] indexing) right for every order_dim?
  * that the column ORDER is still x0..xN regardless of order_dim
  * whether a serial run and a concatenated parallel run now
    produce the same rows in the same order (the property the
    unit exists for)
  <b>Verified</b>: same 118 rows, different order, in both paths;
  netCDF output untouched.
end legend

@enduml

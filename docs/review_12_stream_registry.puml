@startuml review_12_stream_registry
' Review unit 12 of 15 -- see docs/review_diagrams.md for the series.
' State AFTER commit 77d4b72 (src +349/-94 across 11 files).
' Every number below is from a run of the two cases at commit 77d4b72.
' Render: plantuml docs/review_12_stream_registry.puml

title Unit 12 -- every random stream from one tagged registry (77d4b72)

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #FCFCFC
  BorderColor #777777
  DiamondBackgroundColor #F2F2F2
  DiamondBorderColor #777777
}
skinparam partition {
  BorderColor #8899AA
  FontColor #33495E
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

start

partition "the call -- unchanged parameters, two cases" {
  :GenerateData(
     num_obs=100, num_dims=3, ratio_dims=[1, 2, 2],
     density=[0.4, 0.1], seed=77,
     num_vars=2, var_dims=[3, 2],
     overlap=0.5, fixed_overlap=False,
     <b>case A</b>: max_obs=None      <b>case B</b>: max_obs=40)
  .generate(netcdf_filepath, parquet_filepath, parquet_tmp, merge_nc);
}

partition "how a generator is derived -- the whole unit" {
  #FFCDD2:streams were derived by ARITHMETIC on the seed:
  default_rng(seed + dim*1000) per coordinate axis,
  default_rng(seed + 9999) for the shared overlap ordering,
  default_rng(seed + 2000 + i) per variable,
  plus chunk shifts of chunk_id*100 and chunk_id*10000,
  and the ad-hoc list forms [seed, 1] and [seed, 2, j] from unit 02;
  note right #FFCDD2
    These collided silently. seed + 0*1000 is the seed
    itself, so the x0 axis and the density draw were one
    stream; seed + 5000 is seed + 5*1000, so at six
    dimensions the x5 axis and var0's dimension selection
    were one stream.
  end note
  #C8E6C9:<b>data_sparsity/utils/streams.py</b>
  stream(seed, tag, *index) hands the tuple to
  numpy.random.default_rng, which runs it through SeedSequence,
  so distinct tuples give independent generators;
  #C8E6C9:every component is SHIFTED UP BY ONE before reaching NumPy,
  because SeedSequence ignores trailing zeros: without the shift
  the x0 axis, (seed, 0, 0), would be plain default_rng(seed).
  A negative index raises, since it would undo the shift;
  #C8E6C9:the tags, in class Stream:
    COORDINATE 0    one coordinate axis, by dimension
    LHS 1           the global Latin hypercube stage
    STRATUM 2       per-stratum fill and values, by stratum
    DENSITY 3       per-variable densities from a range
    VAR_DIMS 4      which dimensions a variable varies along
    CONST_COORD 5   a variable's coordinate on a constant dim
    VAR 10          per-variable placement, by variable and stratum
    SHARED_OVERLAP 11  the shared ordering behind fixed_overlap;
  #C8E6C9:<b>no tuple contains a chunk id</b>. Serial and every worker
  derive the same generator for the same purpose, and chunks differ
  only in WHICH strata they ask for;
}

partition "what that does to this example" {
  #FFF9C4:the VAR_DIMS draw moves, so var1's geometry changes:
  var_dims_indices [ [0,1,2], [0,2] ] -> <b>[ [0,1,2], [1,2] ]</b>
  var_constant_dims [ [], [1] ] -> <b>[ [], [0] ]</b>
  var1 is now constant on <b>x0</b> (length 4), pinned at index 2,
  and varies on the 8x8 plane instead of a 4x8 one;
  #FFF9C4:_choose_split_dim follows: shared dims are now 1 and 2,
  so <b>dim_split 2 -> 1</b>;
  #FFF9C4:the COORDINATE draws move, so every axis is a new sample:
  first parquet row (0.243888, 0.231410, 0.150654, var0 0.509314)
  becomes (0.102682, 0.021245, 0.883997, var0 0.181848);
  #FFF9C4:the overlap the same target now achieves changes, because
  var0's projection is measured on a bigger plane:
  |proj(var0)| 32 -> <b>57</b>, var1 still covers all 26 of its cells
  <b>F1 0.8125 -> 0.4561</b> (target 0.5), F2 stays 1.0
  per-stratum: |proj0| is 7, 7, 7, 8, 7, 6, 8, 7 and var1 takes
  3, 3, 3, 3, 3, 3, 4, 4 of them;
  #FFF9C4:parquet rows 118 -> <b>116</b>, var1 in netCDF is now (x1, x2);
}

if (NTASKS) then (== 1  -- CASE A, serial)
  #FFF9C4:ds.nc 15729 B, parquet_0.parquet 6265 B, 116 rows,
  overlap_actual_f1 0.4561, overlap_actual_f2 1.0;
else (== 3  -- CASE B, parallel)
  #FFF9C4:chunks are cut along x1 again:
  ds_0.nc (x0 4, x1 3, x2 8) var0 37, var1 9
  ds_1.nc (x0 4, x1 3, x2 8) var0 39, var1 9
  ds_2.nc (x0 4, x1 2, x2 8) var0 26, var1 8
  13704 B each, parquet_0.parquet 5965 B, merged ds.nc 15488 B.
  Totals 102 and 26, matching serial;
endif

partition "the single-variable flow (num_vars=1, density=0.4)" {
  #FFE0B2:touched: the COORDINATE tag replaces seed + dim*1000, so the
  axes and therefore the placement change. 102 observations,
  per-stratum counts still 12, 12, 13, 13, 13, 13, 13, 13,
  first row now (0.102682, 0.021245, 0.883997, record 0.181848);
}

stop

legend right
  |<#C8E6C9> green |= added or changed by THIS unit |
  |<#FFCDD2> red |= removed by THIS unit |
  |<#FFE0B2> orange |= single-variable flow touched by THIS unit |
  |<#FFF9C4> yellow |= generated data or file that changed as a result |
  | plain | unchanged since unit 11 |

  <b>What to review in unit 12</b>
  * the shift-by-one argument in stream(): is every tuple really
    distinct from every zero-extension of another?
  * that no call site reintroduces a chunk id into a stream
  * the tag VALUES are frozen: VAR and SHARED_OVERLAP keep 10 and
    11 so the placement introduced in unit 03 is undisturbed
  * every former offset has a tag, and no offsets remain anywhere
  <b>Verified</b>: this is the largest data change in the branch.
  Serial and parallel still agree (102 and 26 in both).
end legend

@enduml

@startuml review_layout_02_padded_placement
' Review unit 02 of 05 -- see docs/review_layout.md for the series.
' State AFTER commit 14d7be1 (src +390/-5, tests +210, docs +23).
' Every number below is from a run of the cases at commit 14d7be1.
' Render: plantuml -tsvg docs/review_layout_02_padded_placement.puml

title Unit 02 -- layout="padded": each line fills its first k cells of one axis (7f83754..14d7be1)

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #FCFCFC
  BorderColor #777777
  DiamondBackgroundColor #F2F2F2
  DiamondBorderColor #777777
}
skinparam partition {
  BorderColor #8899AA
  FontColor #33495E
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

start

partition "the call" {
  #C8E6C9:GenerateData(num_obs=100, num_dims=3, ratio_dims=[1, 2, 2], seed=77,
     <b>case P1</b>: density=0.4, <b>layout="padded"</b>,
     <b>case P2</b>: density=[0.4, 0.1], num_vars=2, var_dims=[3, 2], <b>layout="padded"</b>
     max_obs=None or 40)
  NEW keywords: layout ("scattered" default, "padded"), padded_dim (default: last);
}

partition "GenerateData constructor" {
  #C8E6C9:checks: layout known; padded needs >= 2 dims; padded_dim in range
  overlap other than "random" with padded -> ValueError
  (case E1, overlap=0.5: raises);
  #C8E6C9:SparsityValidator.compute_min_density(shape, padded_dim)
  padded: (prod(shape)/n_padded + n_padded - 1) / prod(shape)
  [4, 8, 8], padded x2: (32 + 7) / 256 = <b>0.15234</b> (scattered 0.03125);
  #C8E6C9:_choose_split_dim excludes padded_dim -> dim_split 1;
  #FFF9C4:case P2: var1's density 0.1 is below 0.15234 and is clipped,
  with a warning: var_num_obs 102 and <b>10</b> (scattered: 6);
}

partition "RecordGenerator.generate_stratified_indices(layout=...)" {
  if (layout) then (padded)
    #C8E6C9:<b>generate_padded_indices</b>  (NEW) -- no LHS stage
    a line = one combination of the dims other than split and padded;
    #C8E6C9:<b>padded_stratum_counts</b>  (NEW)
    floor of one observation per line, the rest apportioned by
    lognormal weights (stream PADDED, NEW tag; equal weights from unit 04), capped per stratum,
    one stratum raised to afford a full-length line;
    #C8E6C9:ChunkUtils.apportion(total, weights, <b>capacity</b>)
    the capacity argument is restored: main removed it as dead code,
    and lognormal weights are not capacities;
    #C8E6C9:<b>_prefix_lengths</b>  (NEW; _first_occupied_per_line from unit 04) per stratum: how far each line
    reaches, 1..n_padded, positions 0..k-1 of the padded axis;
  else (scattered)
    :LHS stage + uniform fill, unchanged;
  endif
}

#FFF9C4:<b>case P1</b>, along x2 (32 lines of 8)
cells per line: min 1, median <b>2</b>, mean 3.19, max <b>8</b>.
every line fills its first k cells: <b>yes</b>; every coordinate used: yes
ds.nc 14061 B, parquet 5402 B (scattered 14061 / 5396);
note right
  Same sizes: this package writes netCDF
  uncompressed, so the arrangement shows
  in the bytes only once compression is on.
end note

#FFF9C4:<b>case P2</b> --
var0: every line fills its first k cells, as in P1
var1 (on x1, x2): 10 cells, NOT its first k cells -- per stratum, scattered;
note right #FFCDD2
  <b>Finding</b>: only var0 is padded.
  generate_multivar_stratified passes the
  layout to var0's placement only; the
  others keep the scattered per-stratum
  draw. The reason overlap raises -- "every
  line fills its first k cells of the same axis"
  -- does not hold. #24 has no multi-variable
  padded test; this predates the rebase.
end note

:<b>case A, case S</b> (layout not set): byte-identical to unit 00
serial equals parallel in every case;

stop

legend right
  |<#C8E6C9> green |= added or changed by THIS unit |
  |<#FFCDD2> red |= removed by THIS unit |
  |<#FFE0B2> orange |= single-variable flow touched by THIS unit |
  |<#FFF9C4> yellow |= generated data or file that changed as a result |
  | plain | unchanged since unit 01 |

  <b>What to review in unit 02</b>
  * padded_stratum_counts: floors, lognormal weights (equal in unit 04),
    capacities, the full-length carrier
  * the restored capacity argument of apportion
  * min density and dim_split under padded
  * <b>open</b>: only var0 is padded (P2), and padded's
    higher minimum, a var0 coverage bound, also
    clips every other variable's density
  <b>Size</b>: +623/-5, over the 400 target; 210 of it is
  tests/generators/test_padded_layout.py
  <b>Verified</b>: 574 tests pass.
end legend

@enduml

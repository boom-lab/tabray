@startuml dataflow
' How a tabray run turns parameters into two files on disk.
' Terminology: docs/explainer.md, docs/explainer_multivar.md.
' Render: plantuml docs/dataflow.puml

title tabray: from parameters to netCDF and parquet on disk

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #FCFCFC
  BorderColor #777777
  DiamondBackgroundColor #F2F2F2
  DiamondBorderColor #777777
}
skinparam partition {
  BorderColor #8899AA
  FontColor #33495E
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

start

partition "GenerateData.__init__  (caller's parameters)" {
  :GenerateData(
    num_obs, num_dims, ratio_dims,
    density or sparsity, seed,
    num_vars, var_dims, overlap, fixed_overlap,
    max_obs, max_workers);
}

partition "validators/  (shape and counts)" {
  :<b>ParameterValidator</b>
  num_obs, num_dims, seed, num_vars
  var_dims  -> per-variable dimension count
  ratio_dims -> array
  density_refvar -> var0 forced to the largest density;

  :<b>DimensionValidator</b>
  nb_coords_dim1 = (num_obs / (density * prod(ratio_dims))) ** (1/num_dims)
  nb_coords_per_dim = ratio_dims * nb_coords_dim1  (rounded)
  -> <b>shape</b>, <b>total_grid_points</b>;

  :<b>SparsityValidator</b>
  density_zero = max(shape) / prod(shape)
  validate_density_bounds, validate_num_obs_consistency
  -> corrected <b>num_obs</b>, <b>density</b>;
  note right
    Part-hard, part-soft: unusable input raises,
    rounding-level input is corrected and printed.
    Read num_obs / density / shape back from the
    instance, never from the constructor argument.
  end note
}

partition "config/  (per-variable geometry)" {
  if (num_vars > 1?) then (yes)
    :<b>MultiVarSparsityConfig</b>   stream DENSITY
    -> var_densities, var_num_obs;
    :<b>MultiVarDimensionsConfig</b>  streams VAR_DIMS, CONST_COORD
    -> var_dims_indices, var_constant_dims,
       var_constant_coord_indices;
    :<b>MultiVarOverlapConfig</b>
    -> overlap_target, fixed_overlap, adjusted var_num_obs;
  else (no)
    :_configure_single_var
    one variable, every dimension varies,
    no constant dimensions;
  endif

  :<b>dim_split</b> = largest dimension that EVERY variable varies along
  (overlap is measured on shared dimensions, so a variable
  constant along the split axis would break per-stratum targets);

  :_multiprocessing_setup(max_obs)
  NTASKS = ceil(num_obs / max_obs), or 1 when max_obs is None
  -> section_sizes, div_points along dim_split;
}

:generate(netcdf_filepath, parquet_filepath,
          parquet_tmp, merge_nc);

if (NTASKS) then (== 1: serial)

  partition "generators/  (coordinates)" {
    :<b>ChunkUtils.generate_rngs</b>
    one RNG per dimension: stream(seed, COORDINATE, dim);
    :<b>CoordinateGenerator.generate_all_coords</b>
    x{i} = sort(uniform(0, 1, shape[i]))
    -> coordinates dict {x0 .. x(num_dims-1)};
    note right
      Axis values are the coordinate LABELS.
      Placement works in integer index space and
      meets these labels only at build time.
    end note
  }

  partition "generators/  (placement, one hyperplane at a time)" {
    :<b>MultiVarRecordGenerator.generate</b>
    records[var_i] = full(shape, NaN);

    :_select_constant_coords on the GLOBAL shape
    var_i -> {constant dim: coordinate index};

    :<b>var0</b> = RecordGenerator.generate_stratified_indices
    LHS stage (global): n_s = max(shape), stream(seed, LHS),
      every coordinate of every axis used at least once
    apportion(num_obs - n_s) over strata by free sites
    per stratum j: rng = stream(seed, STRATUM, j)
      sites  = rng.choice(free ranks) -> _ranks_to_local
      values = rng.uniform(0, 1), drawn after the sites;

    while (for each variable i >= 1, each stratum j) is (more)
      :proj = var0's sites in stratum j, seen through
      the dimensions var_i varies along;
      :n_overlap = clip(round(target_i * |proj|), lo, hi)
      lo = forced by lack of free cells, hi = min(n_here, |proj|)
      a clipped target warns: density takes precedence;
      if (fixed_overlap[i]?) then (yes)
        :draw from one shared permutation of proj
        stream(seed, SHARED_OVERLAP, j);
      else (no)
        :draw from proj with stream(seed, VAR, i, j);
      endif
      :remainder drawn from cells held by NEITHER variable,
      so the achieved overlap is the target rather than the
      target plus accidental coincidences;
      :values from the same VAR stream;
    endwhile (done)

    :scatter into the arrays: records[var_i][indices] = values;

    :<b>OverlapCalculator.compute_overlap_report</b>
    overlap = |proj(S0) & proj(Si)| / |proj(S0)|,
    overlap_reverse = ... / |proj(Si)|
    -> overlap_actual, overlap_actual_reverse, printed;
  }

  partition "output/  (two in-memory stores of the same data)" {
    if (num_vars) then (== 1)
      :<b>NetCDFBuilder.build_dataarray</b>
      xr.DataArray(record, coords, name="record", attrs)
      attrs: num_obs, num_dims, ratio_dims, density, seed;
      :<b>ParquetBuilder.build_single_var_dataframe</b>
      non-NaN sites -> one row per observation,
      columns x0..xN + "record", dim_split slowest;
    else (> 1)
      :<b>NetCDFBuilder.build_dataset</b>
      one DataArray per var0..varN, attrs += create_multivar_attrs
      (num_vars, var_densities, var_num_obs, overlap_target,
       overlap_convention, fixed_overlap, overlap_actual,
       overlap_actual_reverse)
      squeeze_constant_dims: a variable pinned to one coordinate
      loses that dimension instead of storing a NaN slab;
      :<b>ParquetBuilder.build_multi_var_dataframe</b>
      one row per OCCUPIED coordinate, one column per variable,
      NaN where a variable has no value there, dim_split slowest;
    endif
  }

  partition "disk" {
    :<b>PathManager.setup_output_paths(overwrite=True)</b>
    existing .nc / .parquet / _metadata in the target
    directories are deleted;
    :to_netcdf(path)
    no encoding is passed, so the file is uncompressed;
    :dd.from_pandas(df, npartitions=1).to_parquet(engine="pyarrow")
    no compression keyword is passed, so dask's default,
    Snappy, applies: the two formats are written on
    different terms (see .claude/HANDOFF.md, Compression);
  }

  :return (DataArray or Dataset, DataFrame);
  stop

else (> 1: parallel, experimental)

  partition "parallel setup" {
    :setup_output_paths, remove_scratch_dir(parquet_tmp),
    makedirs(parquet_tmp);
    :<b>ChunkUtils.get_observations_per_chunk</b> (single variable)
    or <b>get_multi_var_observations_per_chunk</b>
    largest-remainder apportionment over chunks
    -> per-chunk counts; rewrites self.num_obs and self.density;
    :one plain-value argument dict per chunk
    (nothing pickles GenerateData);
    :ProcessPoolExecutor(spawn,
       max_workers = min(NTASKS, max_workers or cpu_count));
  }

  partition "workers/generate_chunk  (one process per chunk)" {
    :task_range = div_points[id : id+2], task_shape;
    :coordinates drawn over the GLOBAL shape with the SAME
    per-dimension streams, then the split axis is SLICED
    (order statistics of the whole sample, not a re-draw);
    :MultiVarRecordGenerator.generate(task_shape, ...,
       chunk_id, div_points, lhs_shape = GLOBAL shape)
    the chunk generates only ITS strata, and a stratum is a
    function of (seed, stratum), so it matches serial;
    :build_dataarray / build_dataset(squeeze_constant_dims=False)
    chunk files keep every dimension so they can concatenate;
    :DataFrame with order_dim = dim_split, so a chunk's rows
    are exactly the slice serial would emit;
    :write <b>base_NNN.nc</b> and
    <b>parquet_tmp/chunk_NNNN.parquet</b>
    write_metadata=False: workers share the directory and
    _metadata is a single fixed filename;
  }

  partition "consolidation" {
    :<b>_consolidate_parquet_files</b>
    dd.read_parquet(chunk_*.parquet).repartition("300MB")
    -> the real parquet output, temporaries deleted;

    if (merge_nc?) then (True)
      :<b>_merge_netcdf_files</b>
      open_mfdataset(concat_dim = x{dim_split}), squeeze constant dims,
      then ONE data variable per to_netcdf call under
      dask scheduler="synchronous"
      (concurrent stores make HDF5 lay the file out in completion
      order, and the read and write sides of xarray's netCDF4
      lock can deadlock);
      :single merged .nc, chunk files deleted;
    else (False)
      :chunk .nc files kept: the only option when the
      output is too large to merge;
    endif
  }

  :return (None, None) -- results exist only on disk;
  stop
endif

legend right
  |= stream tag |= indexed by |= draws |
  | COORDINATE | dimension | one coordinate axis |
  | LHS | -- | the global Latin hypercube stage |
  | STRATUM | stratum | var0 fill sites and values |
  | DENSITY | -- | per-variable densities from a range |
  | VAR_DIMS | variable | which dimensions a variable varies along |
  | CONST_COORD | variable, constant dim | its coordinate on that dim |
  | VAR | variable, stratum | per-variable placement and values |
  | SHARED_OVERLAP | stratum | the shared ordering for fixed_overlap |
  No tag carries a chunk id, which is what lets a parallel
  run reproduce the serial data exactly.
end legend

@enduml

@startuml review_05_shared_attrs
' Review unit 05 of 15 -- see docs/review_diagrams.md for the series.
' State AFTER commit 6390501 (src +98/-22, tests included).
' Every number below is from a run of the two cases at commit 6390501.
' Render: plantuml docs/review_05_shared_attrs.puml

title Unit 05 -- both paths write the same self-describing attributes (2368f7c..6390501)

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #FCFCFC
  BorderColor #777777
  DiamondBackgroundColor #F2F2F2
  DiamondBorderColor #777777
}
skinparam partition {
  BorderColor #8899AA
  FontColor #33495E
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

start

partition "the call -- unchanged parameters, two cases" {
  :GenerateData(
     num_obs=100, num_dims=3, ratio_dims=[1, 2, 2],
     density=[0.4, 0.1], seed=77,
     num_vars=2, var_dims=[3, 2],
     overlap=0.5, fixed_overlap=False,
     <b>case A</b>: max_obs=None      <b>case B</b>: max_obs=40)
  .generate(netcdf_filepath, parquet_filepath, parquet_tmp);
}

partition "validate, configure, place, measure -- unchanged" {
  :shape [4, 8, 8], num_obs 102, var_num_obs 102 and 26, dim_split 2
  per-stratum placement as in unit 03, F1 0.8125 and F2 1.0
  as measured in unit 04. No site moves in this unit;
  #C8E6C9:_generate_multi_var_records now keeps BOTH numbers:
  self.overlap_actual = report f1 and self.overlap_actual_f2 = report f2;
}

if (NTASKS) then (== 1  -- CASE A, serial)

  partition "serial attributes" {
    #FFCDD2:attrs were: num_obs, num_dims, ratio_dims, density, seed,
    description, overlap_target, fixed_overlap -- eight keys, of which
    num_obs and density described the reference variable only, so a
    reader could not tell what var1 was;
    #C8E6C9:<b>NetCDFBuilder.create_multivar_attrs</b>, called by BOTH paths
    num_vars, var_densities, var_num_obs,
    overlap_target, fixed_overlap,
    overlap_actual_f1, overlap_actual_f2,
    overlap_convention (the F1 formula, spelled out in the file);
    #C8E6C9:the base attrs are also made consistent: num_obs and density now
    come from var_num_obs[0] and var_num_obs[0]/total_grid_points,
    the same quantities the chunk files record;
    #FFF9C4:serial ds.nc: 8 attributes -> <b>14</b>, file <b>12589 -> 15729 B</b>
    overlap_actual_f1 = 0.8125, overlap_actual_f2 = 1.0,
    var_num_obs = 102 and 26, var_densities = 0.4 and 0.1;
  }

else (== 3  -- CASE B, parallel)

  partition "chunk attributes" {
    :chunks already wrote num_vars, var_densities, var_num_obs,
    overlap_target, fixed_overlap and chunk_id -- this unit routes
    them through the same create_multivar_attrs call;
    #C8E6C9:chunks gain <b>overlap_convention</b>, so a chunk file also
    states which definition its overlap_target uses;
    :the achieved F1/F2 are NOT written per chunk: a chunk's
    achieved overlap is a property of its slice, not of the dataset;
    #FFF9C4:ds_0.nc, ds_1.nc, ds_2.nc <b>12290 -> 13704 B</b> each;
  }

endif

partition "the single-variable flow (num_vars=1, density=0.4)" {
  #FFE0B2:the attribute set is unchanged (create_multivar_attrs adds
  nothing when num_vars == 1), but the instance gains an
  overlap_actual_f2 attribute set to None. Files byte-identical:
  ds.nc 14061 B, parquet 5401 B;
}

stop

legend right
  |<#C8E6C9> green |= added or changed by THIS unit |
  |<#FFCDD2> red |= removed by THIS unit |
  |<#FFE0B2> orange |= single-variable flow touched by THIS unit |
  |<#FFF9C4> yellow |= generated data or file that changed as a result |
  | plain | unchanged since unit 04 |

  <b>What to review in unit 05</b>
  * create_multivar_attrs: the as_list coercion, and that netCDF
    can serialise every value it produces
  * num_obs and density in the base attrs now mean "var0", which
    is a semantic change to files already in circulation
  * whether achieved overlap belongs in a chunk file at all
  <b>Verified</b>: serial and chunk files now carry the same
  descriptive keys; no placed site moves.
end legend

@enduml

@startuml review_10_scratch_and_logging
' Review unit 10 of 15 -- see docs/review_diagrams.md for the series.
' State AFTER commits d49efbc, b218154 (src +172/-74).
' Every number below is from a run of the two cases at commit b218154.
' Render: plantuml docs/review_10_scratch_and_logging.puml

title Unit 10 -- scratch directory and worker logging (d49efbc, b218154)

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #FCFCFC
  BorderColor #777777
  DiamondBackgroundColor #F2F2F2
  DiamondBorderColor #777777
}
skinparam partition {
  BorderColor #8899AA
  FontColor #33495E
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

start

partition "the call -- unchanged parameters, two cases" {
  :GenerateData(
     num_obs=100, num_dims=3, ratio_dims=[1, 2, 2],
     density=[0.4, 0.1], seed=77,
     num_vars=2, var_dims=[3, 2],
     overlap=0.5, fixed_overlap=False,
     <b>case A</b>: max_obs=None      <b>case B</b>: max_obs=40)
  .generate(netcdf_filepath="out/netCDF/ds.nc",
            parquet_filepath="out/parquet",
            <b>parquet_tmp="out/tmp/chunk"</b>, merge_nc);
}

partition "validate, configure, place -- unchanged" {
  :shape [4, 8, 8], num_obs 102, dim_split 2, F1 0.8125, 118 rows;
}

if (NTASKS) then (== 1  -- CASE A, serial)

  partition "serial paths" {
    #C8E6C9:PathManager.setup_output_paths now treats parquet_tmp as a
    DIRECTORY NAME and just creates it. It used to run the value
    through prepare_parquet_path;
    #FFF9C4:no output change: ds.nc 15729 B, parquet_0.parquet 6263 B;
  }

else (== 3  -- CASE B, parallel)

  partition "scratch directory (d49efbc)" {
    #FFCDD2:tmp_dir = os.path.dirname(self.parquet_tmp), then
    shutil.rmtree(tmp_dir) with a bare except.
    With parquet_tmp pointing at a file prefix, dirname resolved to
    the PARQUET OUTPUT DIRECTORY, so the scratch chunks were written
    beside the real output and the cleanup deleted the user's
    output directory;
    #C8E6C9:parquet_tmp IS the scratch directory
    <b>PathManager.remove_scratch_dir(self.parquet_tmp)</b> before the run
    and again after the merge succeeds;
    #C8E6C9:remove_scratch_dir refuses to delete a directory holding
    anything this run did not write: entries must start with
    chunk_, _metadata or _common_metadata, and no subdirectories.
    Otherwise it prints what it found and keeps the directory;
    note right #C8E6C9
      A mistyped path now fails loudly instead of
      destroying data.
    end note
    #C8E6C9:ParquetBuilder.save_to_file takes write_metadata, defaulting
    to "only when this is not a chunk"; workers pass False explicitly,
    because several processes writing _metadata into one shared
    directory race for the same two filenames;
    #FFF9C4:measured: <b>tmp/_metadata (3807 B) and tmp/_common_metadata
    (3025 B) are no longer left behind</b> in the output tree.
    Data files unchanged: three chunk files of 13704 B,
    parquet_0.parquet 5899 B;
  }

  partition "worker logging (b218154)" {
    #FFCDD2:logging.basicConfig(level=DEBUG) inside the worker, which
    configured the ROOT logger -- so every library in the process
    logged as well -- and wrote worker_<id>.log into the current
    working directory, whatever that happened to be;
    #C8E6C9:<b>_configure_worker_logging(chunk_id, netcdf_filepath)</b>
    a named logger data_sparsity.worker.<id> with propagate=False,
    a NullHandler and WARNING level unless <b>TABRAY_WORKER_LOG</b> is
    set to debug or info. When set, the file lands beside the
    netCDF output, not in the cwd;
  }

endif

partition "the single-variable flow (num_vars=1, density=0.4)" {
  #FFE0B2:same scratch-directory change: the leftover tmp/_metadata and
  tmp/_common_metadata disappear from the single-variable parallel
  output too. Data files byte-identical;
}

stop

legend right
  |<#C8E6C9> green |= added or changed by THIS unit |
  |<#FFCDD2> red |= removed by THIS unit |
  |<#FFE0B2> orange |= single-variable flow touched by THIS unit |
  |<#FFF9C4> yellow |= generated data or file that changed as a result |
  | plain | unchanged since unit 09 |

  <b>What to review in unit 10</b>
  * remove_scratch_dir: the allow-list, the subdirectory refusal,
    and what happens when it declines to delete
  * parquet_tmp changing meaning from "file prefix" to "directory"
    -- any caller or notebook still passing the old form?
  * write_metadata default of "not a chunk", and the race it avoids
  * the logger being off by default, and the TABRAY_WORKER_LOG values
  <b>Verified</b>: two stray metadata files disappear from the output
  tree; every data file is byte-identical.
end legend

@enduml

@startuml review_08_overlap_api
' Review unit 08 of 15 -- see docs/review_diagrams.md for the series.
' State AFTER commits 86479f5, 2748cf8, b46195b (src +14/-293).
' Every number below is from a run of the two cases at commit b46195b.
' Render: plantuml docs/review_08_overlap_api.puml

title Unit 08 -- one entry point for overlap, pooled metric dropped (b46195b)

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #FCFCFC
  BorderColor #777777
  DiamondBackgroundColor #F2F2F2
  DiamondBorderColor #777777
}
skinparam partition {
  BorderColor #8899AA
  FontColor #33495E
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

start

partition "the call -- unchanged parameters, two cases" {
  :GenerateData(
     num_obs=100, num_dims=3, ratio_dims=[1, 2, 2],
     density=[0.4, 0.1], seed=77,
     num_vars=2, var_dims=[3, 2],
     overlap=0.5, fixed_overlap=False,
     <b>case A</b>: max_obs=None      <b>case B</b>: max_obs=40)
  .generate(netcdf_filepath, parquet_filepath, parquet_tmp, merge_nc);
}

partition "validate, configure, place -- unchanged" {
  :shape [4, 8, 8], num_obs 102, var_num_obs 102 and 26, dim_split 2
  per-stratum placement, F1 0.8125 and F2 1.0, 118 parquet rows;
}

partition "generators/overlap_calculator.py -- surface area only" {
  #FFCDD2:<b>compute_actual_overlap</b> -- the pooled metric.
  It summed coincidences over all non-reference variables and
  divided by their combined observation count, so it answered a
  question about no particular pair and, in a run with more than
  two variables, could not be attributed to any of them.
  Unreferenced since unit 04;
  #FFCDD2:<b>compute_pairwise_overlap_non_normalized</b> -- the counting
  helper that only the pooled metric used;
  #FFCDD2:<b>compute_actual_overlaps_against_reference</b> -- a one-line
  wrapper that returned compute_overlap_report()["f1"];
  #C8E6C9:every caller now goes to <b>compute_overlap_report</b>, which
  returns f1, f2, shared, ref_size and var_size together.
  The callers are: MultiVarRecordGenerator.generate (which returns
  report f1) and GenerateData._generate_multi_var_records (which
  stores f1 and f2);
  note right
    Three names for one measurement meant a reader had
    to check which convention a given call site used.
    After this unit the definition lives in exactly one
    function and the docstring beside it.
  end note
}

if (NTASKS) then (== 1  -- CASE A, serial)
  #FFF9C4:no change: ds.nc 15729 B, parquet_0.parquet 6263 B,
  118 rows, overlap_actual 0.8125, overlap_actual_f2 1.0;
else (== 3  -- CASE B, parallel)
  #FFF9C4:no change: three chunk files of 13704 B,
  parquet_0.parquet 5899 B, merged ds.nc 15488 B when merge_nc is True;
endif

partition "the single-variable flow (num_vars=1, density=0.4)" {
  :untouched: the removed functions returned None or raised for
  num_vars == 1 and were never reached on that path.
  Files byte-identical;
}

stop

legend right
  |<#C8E6C9> green |= added or changed by THIS unit |
  |<#FFCDD2> red |= removed by THIS unit |
  |<#FFE0B2> orange |= single-variable flow touched by THIS unit |
  |<#FFF9C4> yellow |= generated data or file that changed as a result |
  | plain | unchanged since unit 07 |

  <b>What to review in unit 08</b>
  * that nothing outside the tests called the three removed
    functions (this is the whole risk of the unit)
  * whether compute_overlap_report's return dict is the right
    shape for every caller, including the print helper
  <b>Verified</b>: byte-identical output in all cases, serial and
  parallel, before and after the unit.
end legend

@enduml

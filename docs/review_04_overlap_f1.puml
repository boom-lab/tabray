@startuml review_04_overlap_f1
' Review unit 04 of 15 -- see docs/review_diagrams.md for the series.
' State AFTER commits 5199b5e, 2368f7c (src +262/-57 plus a 686-line diagnostics note).
' Every number below is from a run of the two cases at commit 2368f7c.
' Render: plantuml docs/review_04_overlap_f1.puml

title Unit 04 -- report overlap as F1, with F2 alongside (2368f7c)

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #FCFCFC
  BorderColor #777777
  DiamondBackgroundColor #F2F2F2
  DiamondBorderColor #777777
}
skinparam partition {
  BorderColor #8899AA
  FontColor #33495E
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

start

partition "the call -- unchanged parameters, two cases" {
  :GenerateData(
     num_obs=100, num_dims=3, ratio_dims=[1, 2, 2],
     density=[0.4, 0.1], seed=77,
     num_vars=2, var_dims=[3, 2],
     overlap=0.5, fixed_overlap=False,
     <b>case A</b>: max_obs=None      <b>case B</b>: max_obs=40)
  .generate(netcdf_filepath, parquet_filepath, parquet_tmp);
}

partition "validate, configure, place -- all unchanged" {
  :shape [4, 8, 8], num_obs 102, var_num_obs 102 and 26
  var1 constant on x1 at index 2, dim_split 2, overlap_target 0.5
  per-stratum placement exactly as in unit 03:
  var0 12, 12, 13, 13, 13, 13, 13, 13 and var1 3, 3, 3, 3, 3, 3, 4, 4
  <b>not one placed site moves in this unit</b>;
}

partition "measuring the overlap -- the definition changes" {
  #FFCDD2:compute_actual_overlap: pooled over all non-reference
  variables, counted in FULL coordinate space, and divided by the
  number of NON-reference observations
  |S0 & S1| / |S1| = 10/26 = <b>0.3846</b> for this run;
  note right #FFCDD2
    Two problems. It counted coincidences in the full
    space, where a variable pinned to one coordinate can
    only coincide inside that slice; and it divided by
    the variable, not by the reference, so it reported
    F2 while the generator was targeting F1.
  end note
  #C8E6C9:<b>OverlapCalculator.compute_overlap_report</b>
  projects both variables onto the dimensions they SHARE,
  then returns, per variable i:
     shared  = |proj(S0) & proj(Si)|
     ref_size = |proj(S0)|, var_size = |proj(Si)|
     <b>F1 = shared / ref_size</b>   <b>F2 = shared / var_size</b>;
  note right #C8E6C9
    F1 is what generate_multivar_stratified targets, so
    it is what the run reports. F2 is printed beside it
    because either can be assumed by a reader, and
    F2 = F1 * n0/ni does not hold once the projections
    differ in size.
  end note
  #C8E6C9:<b>print_overlap_report</b>
  "Achieved overlap against var0 (F1 = share of var0's sites also
   carrying the variable; F2 = the reverse):
     var1: F1 0.8125  F2 1.0000  (26 shared of 32 var0 sites,
     26 own sites)  target F1 0.5000";
  #FFF9C4:self.overlap_actual for this run: <b>0.3846 -> 0.8125</b>
  measured on identical data. |proj0| = 32 on the shared dims
  (x0, x2), var1 covers 26 of them, and all 26 of var1's own
  cells sit on var0, so F2 = 1.0;
}

if (NTASKS) then (== 1  -- CASE A, serial)
  :Dataset var0 (x0,x1,x2) and var1 (x0,x2), 118-row DataFrame
  attrs still carry only overlap_target and fixed_overlap
  -- the achieved numbers reach the file in unit 05;
  #FFF9C4:ds.nc 12589 B, parquet_0.parquet 6260 B  (unchanged);
else (== 3  -- CASE B, parallel)
  :each worker measures its own chunk and prints its own report,
  so three reports appear, one per chunk, each against that
  chunk's slice of var0;
  #FFF9C4:ds_0.nc, ds_1.nc, ds_2.nc 12290 B each  (unchanged);
endif

partition "the single-variable flow (num_vars=1, density=0.4)" {
  #FFE0B2:only the reported value changes shape: overlap_actual goes
  from None to an empty array, since compute_overlap_report returns
  empty arrays when there is no second variable. No data change,
  no file change;
}

stop

legend right
  |<#C8E6C9> green |= added or changed by THIS unit |
  |<#FFCDD2> red |= removed by THIS unit |
  |<#FFE0B2> orange |= single-variable flow touched by THIS unit |
  |<#FFF9C4> yellow |= generated data or file that changed as a result |
  | plain | unchanged since unit 03 |

  <b>What to review in unit 04</b>
  * compute_overlap_report: projection onto shared dimensions,
    and the empty-input case
  * that F1 is the number stored in overlap_actual, matching
    what the placement code targets
  * print_overlap_report wording -- it is the only place a user
    learns which convention the run used
  <b>Verified</b>: no placed site moves; the reported overlap for
  the example goes 0.3846 -> 0.8125 on identical data.
end legend

@enduml

@startuml callpath_stratified_placement
' Which calls lead to RecordGenerator.generate_stratified_indices, in a serial
' run and in each parallel worker. Line numbers are as of this commit and drift
' with edits; the method names are the stable reference. A ":N" on an arrow is
' a line in the file of the participant the arrow starts from.
' Render: plantuml docs/callpath_stratified_placement.puml

title Serial and parallel runs reach the same stratified placement

caption ":N" on an arrow = line N in the file of the participant the arrow starts from

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam sequence {
  ParticipantBorderColor #777777
  ParticipantBackgroundColor #FCFCFC
  LifeLineBorderColor #AAAAAA
  GroupBorderColor #8899AA
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

participant "GenerateData\n(generate_data.py)" as GD
participant "ProcessPoolExecutor\n(spawn)" as POOL
participant "generate_chunk\n(parallel_worker.py)\none process per chunk" as W
participant "MultiVarRecordGenerator\n.generate" as MG
participant "generate_without_overlap\n(num_vars == 1)" as GWO
participant "generate_multivar_stratified\n(num_vars > 1)" as GMS
participant "RecordGenerator\n.generate_stratified_indices" as RG

== caller ==

alt NTASKS == 1 (serial)
  GD -> GD : generate() :815\n_generate_multi_var_records()
  GD -> MG : :514  shape = GLOBAL\nno chunk_id, no div_points
else NTASKS > 1 (parallel)
  GD -> GD : generate() :848\n_generate_par()
  GD -> POOL : :989  submit(generate_chunk, **args)\nonce per chunk
  POOL -> W : run chunk k in its own process
  note right of W
    :161  coordinates are drawn on the GLOBAL
    shape, then the split axis is sliced
    to this chunk: x[div_points[k] : div_points[k+1]]
  end note
  alt num_vars == 1
    W -> MG : :171  shape = task_shape (chunk-sized)\nvar_num_obs = [obs_in_chunk]\nlhs_shape = GLOBAL shape\nnum_obs_global = GLOBAL count\nchunk_id = k, div_points
  else num_vars > 1
    W -> MG : :256  shape = task_shape\nvar_num_obs = GLOBAL per-variable counts\nlhs_shape = GLOBAL shape\nchunk_id = k, div_points
  end
end

== dispatch by number of variables ==

alt num_vars > 1   (:245 in MultiVarRecordGenerator.generate)
  MG -> MG : :268  strata = range(div_points[k], div_points[k+1])\nor None when serial
  MG -> GMS : :273  global_shape, strata
  GMS -> RG : :388  var0: num_obs = GLOBAL count, strata
  RG --> GMS : var0 indices (GLOBAL split index), values
  GMS -> GMS : var1..varN, per requested stratum\nstream(seed, VAR, i, j)
  GMS --> MG : indices (GLOBAL), values
  MG -> MG : :292  rebase split axis: index - stratum_start
else num_vars == 1   (falls through the branch above)
  MG -> GWO : :309
  GWO -> GWO : :148  global_shape = lhs_shape or shape\n:149  total_obs = num_obs_global or num_obs\n:151  wanted = chunk's strata, or None
  GWO -> RG : :157  global_shape, total_obs, strata = wanted
  RG --> GWO : indices (GLOBAL split index), values
  GWO -> GWO : :167  rebase split axis: index - stratum_start
end

note over RG
  Inside generate_stratified_indices (record_generator.py :143)
  :197  LHS stage on the GLOBAL grid, stream(seed, LHS)
        identical in every caller
  :215  apportion(num_obs - n_s) over ALL strata
        identical in every caller, because num_obs is GLOBAL
  :223  loop over the REQUESTED strata only,
        stream(seed, STRATUM, j) per stratum
  A stratum depends on (seed, stratum) alone, so a worker's
  strata equal the serial run's slices of the same strata.
end note

@enduml

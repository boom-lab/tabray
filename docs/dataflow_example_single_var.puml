@startuml dataflow_example_single_var
' Worked example: notebooks/tutorial1.ipynb, case "somehow_sparse_grid".
' Every number here is from an actual run of that case.
' Grids: rows x0, columns x1, in index space.
' Render: plantuml docs/dataflow_example_single_var.puml

title Example 1 -- one variable on a 3x3 grid (tutorial1, "somehow_sparse_grid")

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #FCFCFC
  BorderColor #777777
  DiamondBackgroundColor #F2F2F2
}
skinparam partition {
  BorderColor #8899AA
  FontColor #33495E
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

start

partition "call" {
  :GenerateData(num_obs=6, num_dims=2, ratio_dims=1,
                density=6/9, seed=12345)
  .generate(netcdf_filepath=".../netCDF/ds.nc",
            parquet_filepath=".../parquet/ddf");
}

partition "validate and configure" {
  :nb_coords_dim1 = (6 / (0.667 * 1)) ** (1/2) = 3.0
  -> <b>shape = [3, 3]</b>, total_grid_points = 9;
  :density_zero = max(shape)/prod(shape) = 3/9 = 0.333
  0.667 is above it, and 6 observations fit 9 sites,
  so nothing is corrected;
  :num_vars = 1 -> one variable, both dimensions vary,
  no constant dimensions
  <b>dim_split = 0</b>   NTASKS = 1 (no max_obs);
  note right
    The strata are the rows x0 = 0, 1, 2.
    Every grid below is drawn with one stratum per row.
  end note
}

partition "coordinates: the axis LABELS" {
  :x0 = sort(uniform(0,1,3)) with stream(12345, COORDINATE, 0)
  x1 = sort(uniform(0,1,3)) with stream(12345, COORDINATE, 1);
  note right
    x0 = 0.1809, 0.3500, 0.6837
    x1 = 0.7887, 0.9100, 0.9353
    Placement below works in INDEX space
    (0, 1, 2) and never sees these.
  end note
}

partition "placement: LHS, then per-stratum fill" {
  :<b>LHS stage</b>, stream(12345, LHS), n_s = max(shape) = 3
  one permutation per axis:
    x0 = 0, 1, 2
    x1 = 1, 2, 0
  -> sites (0,1), (1,2), (2,0);
  note right
    after the LHS stage
    (L = LHS site, . = vacant)
            x1=0 x1=1 x1=2
      x0=0   .    L    .
      x0=1   .    .    L
      x0=2   L    .    .
    Every row and every column holds a site:
    each coordinate of each axis is used.
  end note

  :<b>fill counts</b>
  6 - 3 = 3 fill points, apportioned over the strata
  by free sites (2 per row once the LHS site is taken)
  -> fill per stratum = 1, 1, 1;

  :<b>stratum 0</b>, rng = stream(12345, STRATUM, 0)
  free sites x1 = 0, 2; rank 0 drawn -> (0,0)
  values for LHS site, then fill site: 0.550, 0.320;
  note right
    after stratum 0
    (f = fill site)
            x1=0 x1=1 x1=2
      x0=0   f    L    .
      x0=1   .    .    L
      x0=2   L    .    .
  end note

  :<b>stratum 1</b>, rng = stream(12345, STRATUM, 1)
  free sites x1 = 0, 1; rank 0 drawn -> (1,0)
  values: 0.742, 0.023;
  note right
    after stratum 1
            x1=0 x1=1 x1=2
      x0=0   f    L    .
      x0=1   f    .    L
      x0=2   L    .    .
  end note

  :<b>stratum 2</b>, rng = stream(12345, STRATUM, 2)
  free sites x1 = 1, 2; rank 0 drawn -> (2,1)
  values: 0.547, 0.134;
  note right
    after stratum 2
            x1=0 x1=1 x1=2
      x0=0   f    L    .
      x0=1   f    .    L
      x0=2   L    f    .
    A stratum reads only its own stream, so it
    can be generated alone: this is what the
    parallel path relies on (Example 6).
  end note

  :record = full([3,3], NaN); record[indices] = values;
  note right
    <b>var0 record</b> (. = vacant site)
             x1=0    x1=1    x1=2
      x0=0   0.320   0.550     .
      x0=1   0.023     .     0.742
      x0=2   0.547   0.134     .
    6 of 9 sites occupied: density 0.667 as asked.
  end note
}

partition "two in-memory stores of the same 6 observations" {
  :<b>NetCDFBuilder.build_dataarray</b>
  xr.DataArray named "record", dims (x0, x1), shape 3x3
  attrs: num_obs=6, num_dims=2, ratio_dims=[1,1],
         density=0.667, seed=12345
  <i>The 3 vacant sites are stored, as NaN.</i>;

  :<b>ParquetBuilder.build_single_var_dataframe</b>
  the non-NaN sites only, x0 (= dim_split) slowest
  <i>Vacant sites are absent; each row repeats its labels.</i>;
  note right
    |= x0 |= x1 |= record |
    | 0.180929 | 0.788706 | 0.320146 |
    | 0.180929 | 0.910005 | 0.550290 |
    | 0.349984 | 0.788706 | 0.023239 |
    | 0.349984 | 0.935274 | 0.742040 |
    | 0.683725 | 0.788706 | 0.547495 |
    | 0.683725 | 0.910005 | 0.134245 |
  end note
}

partition "disk" {
  :setup_output_paths(overwrite=True) clears both directories;
  :netCDF/ds.nc                10500 B
  parquet/ddf_0.parquet         3325 B
  parquet/_metadata             2891 B
  parquet/_common_metadata      2387 B;
  note right
    Each writer uses its library's default:
    netCDF uncompressed, parquet Snappy.
    The payload is 9 doubles (72 B) against 6 rows:
    at this size the container dominates and the
    two figures say nothing about the formats.
  end note
}

:return (DataArray, DataFrame);
stop

@enduml

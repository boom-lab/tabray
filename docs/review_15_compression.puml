@startuml review_15_compression
' Review unit 15 of 15 -- see docs/review_diagrams.md for the series.
' State AFTER commits 7424f42, 3e4f87f, d3e9329, 0f070a1, 5d3cb12
' (src +419/-14 for the codec, plus comment trimming, pylint and black).
' Every number below is from a run of the three cases at commit 5d3cb12 (HEAD).
' Render: plantuml docs/review_15_compression.puml

title Unit 15 -- one codec for both formats (3e4f87f), plus formatting

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #FCFCFC
  BorderColor #777777
  DiamondBackgroundColor #F2F2F2
  DiamondBorderColor #777777
}
skinparam partition {
  BorderColor #8899AA
  FontColor #33495E
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

start

partition "the call -- two new parameters" {
  :GenerateData(
     num_obs=100, num_dims=3, ratio_dims=[1, 2, 2],
     density=[0.4, 0.1], seed=77,
     num_vars=2, var_dims=[3, 2],
     overlap=0.5, fixed_overlap=False,
     <b>compression=None, complevel=4</b>,
     <b>case A</b>: max_obs=None      <b>case B</b>: max_obs=40
     <b>case C</b>: max_obs=None, compression="gzip")
  .generate(netcdf_filepath, parquet_filepath, parquet_tmp, merge_nc);
  note right #C8E6C9
    Before this unit the keywords did not exist:
    <b>TypeError: __init__() got an unexpected keyword
    argument 'compression'</b>
  end note
}

partition "output/compression_settings.py  (NEW)" {
  #C8E6C9:<b>CompressionSettings(codec, level)</b>, built in __init__ so a
  bad codec raises at construction, not at write time.
  Aliases: None, "none", "off" mean uncompressed,
  and "gzip", "zlib", "deflate" all mean DEFLATE;
  #C8E6C9:codecs parquet has and this netCDF build does not --
  snappy, zstd, lz4, brotli -- are REFUSED with a message saying
  why, rather than silently applying to parquet only;
  note right #C8E6C9
    The package exists to compare array storage against
    tabular storage, and the two were not being written
    on the same terms: dask defaults parquet to Snappy
    while to_netcdf writes uncompressed. At 5% density on
    a 20k-observation grid that read netCDF 3.26 MB
    against parquet 0.44 MB; with DEFLATE on both,
    0.42 against 0.29.
  end note
  #C8E6C9:netcdf_encoding(data) -> per data variable
  "zlib": True and "complevel": n
  parquet_kwargs() -> compression="gzip" or compression=None;
  #C8E6C9:the codec name and level travel to the workers as plain
  values (compression_codec, compression_level) and each worker
  rebuilds its own CompressionSettings;
}

partition "validate, configure, place -- unchanged" {
  :shape [4, 8, 8], num_obs 102, dim_split 1, var1 constant on x0
  at index 2, F1 0.4561 and F2 1.0, 116 parquet rows.
  The printed configuration gains a "Compression" line;
}

if (NTASKS) then (== 1  -- CASE A and C, serial)

  partition "writing" {
    :NetCDFBuilder.save_to_file(..., compression)
    to_netcdf(path, encoding=compression.netcdf_encoding(data));
    #C8E6C9:ParquetBuilder.save_to_file(..., compression)
    to_parquet(..., **compression.parquet_kwargs())
    <b>compression=None is now passed explicitly</b>; omitting it left
    dask's Snappy default in place;
    #FFF9C4:case A (compression=None):
    ds.nc 15729 B unchanged, parquet_0.parquet <b>6265 -> 6685 B</b>
    -- the parquet grew because it is genuinely uncompressed now;
    #FFF9C4:case C (compression="gzip", complevel=4):
    ds.nc <b>19433 B</b>, parquet_0.parquet <b>6211 B</b>, same 116 rows,
    same overlap_actual_f1 0.4561;
    note right
      On a grid this small DEFLATE makes the netCDF
      LARGER: enabling zlib switches the variables to a
      chunked HDF5 layout, and the per-chunk bookkeeping
      costs more than the compression saves on 256 cells.
      The figures the package is about were measured on a
      20k-observation grid, where it goes the other way.
    end note
  }

else (== 3  -- CASE B, parallel)

  #FFF9C4:each worker writes its chunks with the same settings:
  three chunk files of 13704 B (uncompressed, unchanged),
  consolidated parquet_0.parquet <b>5965 -> 6101 B</b>,
  and _merge_netcdf_files applies the encoding to the merged file;

endif

partition "the single-variable flow (num_vars=1, density=0.4)" {
  #FFE0B2:touched by the explicit compression=None: the parquet was
  being Snappy-compressed by dask's default and is not any more.
  serial parquet <b>5396 -> 5766 B</b>, parallel <b>5117 -> 5248 B</b>,
  netCDF byte-identical;
}

partition "also in this unit, with no effect on behaviour" {
  :7424f42 trims the long in-code explanations and moves them to
  docs/explainer_stratified_generation.md and
  docs/parallel_architecture_change.md;
  :d3e9329 pylint fixes (+4/-1 once whitespace is ignored),
  0f070a1 black across 51 files, 5d3cb12 drops four stray
  decorators. Verify these by re-running black and pylint,
  not by reading the diff;
}

stop

legend right
  |<#C8E6C9> green |= added or changed by THIS unit |
  |<#FFCDD2> red |= removed by THIS unit |
  |<#FFE0B2> orange |= single-variable flow touched by THIS unit |
  |<#FFF9C4> yellow |= generated data or file that changed as a result |
  | plain | unchanged since unit 14 |

  <b>What to review in unit 15</b>
  * the alias table and the refusal list -- is DEFLATE really the
    only codec both formats have in this build?
  * that compression=None reaches to_parquet explicitly on every
    path, including the worker and the consolidation step
  * netcdf_encoding covering every data variable, in both the
    serial and the merged-parallel writes
  * whether complevel should default to 4
  <b>Verified</b>: parquet sizes move on every path (Snappy gone),
  netCDF unchanged unless a codec is asked for, and the placed
  data is identical in all cases.
end legend

@enduml

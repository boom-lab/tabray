@startuml review_layout_04_fixes
' Review unit 04 of 05 -- see docs/review_layout.md for the series.
' State AFTER commit 294e031 (commits 9eed344, a5ffa7d, 17aeb80, 42b032c, 294e031).
' Every number below is from a run of the cases at commit 294e031.
' Render: plantuml -tsvg docs/review_layout_04_fixes.puml

title Unit 04 -- pad every variable; state the bound; clip var0 only; equal weights; "first k cells" (8b8bfdc..294e031)

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #FCFCFC
  BorderColor #777777
  DiamondBackgroundColor #F2F2F2
  DiamondBorderColor #777777
}
skinparam partition {
  BorderColor #8899AA
  FontColor #33495E
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

start

partition "the call" {
  :<b>case P2</b>: density=[0.4, 0.1], var_dims=[3, 2], layout="padded"
  <b>case P3</b>: density=[0.4, 0.2], var_dims=[3, [1, 2]], layout="padded"
  <b>case P4</b>: density=[0.4, 0.2], var_dims=[3, [0, 1]], layout="padded"
  (num_obs=100, num_dims=3, ratio_dims=[1, 2, 2], seed=77, max_obs=None or 40);
}

partition "MultiVarSparsityConfig.validate_and_clip  (17aeb80)" {
  #C8E6C9:only var0 is clipped to the minimum density, its coverage bound
  the other variables keep the density they asked for;
  #FFCDD2:every variable clipped: P2's var1 went 0.1 -> 0.152, 10 cells;
}

partition "MultiVarRecordGenerator.generate_multivar_stratified, per stratum  (9eed344)" {
  :var0: generate_padded_indices, as in unit 02;
  if (var_i varies along the padded axis?) then (yes)
    #C8E6C9:<b>_padded_cells</b>  (NEW)
    lines = the variable's stratum dims other than the padded one
    count apportioned over lines with equal weights,
    capped at n_padded; a line may stay empty
    each line fills its first k cells of the padded axis
    drawn from the variable's own stream VAR (i, stratum);
    #FFCDD2:before: rng.choice over the whole plane, scattered;
  else (no, e.g. var1 on x0, x1 with x2 padded)
    :scattered, as before: there is no padded axis to fill;
  endif
}

partition "GenerationReport  (a5ffa7d)" {
  #C8E6C9:<b>minimum density</b> row (NEW), both paths, e.g.
  "var0 coverage, padded: (lines + n_padded - 1) / sites"  0.152344
  "var0 coverage, scattered: max(shape) / sites"           0.03125;
}

partition "RecordGenerator, padded counts  (294e031)" {
  #C8E6C9:padded_stratum_counts and _first_occupied_per_line: <b>equal weights</b>
  each stratum an equal share of var0's count, each line an equal
  share of its stratum's, capped at n_padded;
  #FFCDD2:lognormal weights (stream PADDED, now removed): right-skewed
  line lengths, never requested;
}

partition "wording  (42b032c)" {
  #C8E6C9:"fills its first k cells" replaces "prefix" in code comments,
  docstrings, errors and docs; _prefix_lengths -> _first_occupied_per_line;
}

#FFF9C4:<b>case P2</b>, var1 on (x1, x2): <b>6</b> cells (unit 02: 10, clipped)
every line fills its first k cells: <b>yes</b> (unit 02: no, scattered)
two of its 8 lines are empty -- coverage is var0's guarantee only
<b>case P3</b>, var1 on (x1, x2): 13 cells, every line fills its first k cells
<b>case P4</b>, var1 on (x0, x1): no padded axis, scattered, 6 cells
serial equals parallel in all three;

:<b>case A, S, P1</b>: byte-identical to unit 03
(scattered draws untouched; var0 placement unchanged);

stop

legend right
  |<#C8E6C9> green |= added or changed by THIS unit |
  |<#FFCDD2> red |= removed by THIS unit |
  |<#FFE0B2> orange |= single-variable flow touched by THIS unit |
  |<#FFF9C4> yellow |= generated data or file that changed as a result |
  | plain | unchanged since unit 03 |

  <b>What to review in unit 04</b>
  * one layout per dataset: README, CLAUDE.md and the
    plan's stage 4 say so
  * _padded_cells: lines may stay empty, unlike var0's
  * the minimum-density row; the plan's other report rows
    and why the layout check was not built (tests do it)
  * the clip: var0 only
  * equal weights: the PADDED stream tag is gone
  <b>Verified</b>: the suite passes at every commit
  (577, 578, 578, 578, 578).
end legend

@enduml

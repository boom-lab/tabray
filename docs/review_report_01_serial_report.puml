@startuml review_report_01_serial_report
' Review unit 01 of 02 -- see docs/review_report.md for the series.
' State AFTER commit a786b4a (src +304, tests +159, docs +9/-7).
' Every number below is from a run of the cases at commit a786b4a.
' Render: plantuml docs/review_report_01_serial_report.puml

title Unit 01 -- requested against achieved, serial path (f87a0e9..a786b4a)

skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #FCFCFC
  BorderColor #777777
  DiamondBackgroundColor #F2F2F2
  DiamondBorderColor #777777
}
skinparam partition {
  BorderColor #8899AA
  FontColor #33495E
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C8C08A
}

start

partition "the call -- unchanged" {
  :cases A/B, single variable and S, as in unit 00;
}

partition "GenerateData.__init__" {
  #C8E6C9:self._requested = {num_obs, num_dims, ratio_dims, density,
     sparsity, overlap, num_vars, var_dims} --
  stored BEFORE validation rewrites any of them;
}

partition "validate, configure, place, store -- unchanged" {
  :num_obs 102, var_num_obs 102 and 26, F1 0.4561;
}

if (NTASKS) then (== 1  -- CASE A, serial)
  :write ds.nc and the parquet, as before;
  partition "GenerationReport.from_arrays  (NEW, output/generation_report.py)" {
    #C8E6C9:masks = notnull() of each variable in the Dataset
    measured from the arrays, never from gen.var_num_obs;
    #C8E6C9:one row per property, each compare(requested, achieved):
    num_obs         _requested vs gen.num_obs           (adjusted)
    observations    var_num_obs[i] vs occupied cells
    density         var_densities[i] vs occupied / mask size
    coverage        every coordinate of every axis used
    overlap F1      overlap_target vs F1 of the masks
    values in parquet  occupied cells vs non-null column;
    #C8E6C9:status: <b>match</b>, <b>adjusted</b> (the validator's own edit),
    <b>differs</b> (with evidence); render() prints the table
    self.report keeps it;
  }
else (== 3  -- CASE B, parallel)
  :unchanged: no report yet, self.report is not set;
endif

#FFF9C4:<b>case A</b>, serial, printed at the end of the run
  ~ num_obs              requested 100    got 102
    observations var0    requested 102    got 102
  ! density      var0    requested 0.4    got 0.398438
    coverage     var0    every coordinate used: yes
    observations var1    requested 26     got 26
  ! density      var1    requested 0.1    got 0.40625
    coverage     var1    yes
  ! overlap F1   var1    requested 0.5    got 0.45614
    values in parquet var0 102 = 102, var1 26 = 26
  3 of 10 differ from the request;

#FFF9C4:<b>case S</b>: density var1 requested 0.4, got <b>1.0</b>, overlap F1 1.0
the saturation that unit 00 left silent is now a "differs" row
<b>single variable</b>: 0 of 5 differ;

:<b>netCDF and parquet unchanged</b>: every case writes the same
files as unit 00 (A ds.nc 15729 B, single 14061 B);

stop

legend right
  |<#C8E6C9> green |= added or changed by THIS unit |
  |<#FFCDD2> red |= removed by THIS unit |
  |<#FFE0B2> orange |= single-variable flow touched by THIS unit |
  |<#FFF9C4> yellow |= generated data or file that changed as a result |
  | plain | unchanged since unit 00 |

  <b>New files</b>: data_sparsity/output/generation_report.py,
  tests/output/test_generation_report.py
  <b>What to review in unit 01</b>
  * the three statuses, and which rows use adjusted=True
  * density: requested is a share of the FULL grid, achieved is
    occupied / the variable's OWN mask, so var1 (64-cell grid)
    reads 0.40625 for a request of 0.1. The row's evidence text
    explains this instead of fixing the comparison.
  * density var0: 0.4 vs 0.398438 is validator rounding
    (102 / 256) but reads "differs" at tolerance 1e-3
  * overlap F1 "differs" is correct: the target is unreachable
  <b>Verified</b>: output files byte-identical to unit 00;
  547 tests pass.
end legend

@enduml
